## ──────────────────────────────────────────────────────────────────────
##  endpoint_monitor.rules
##  Auditd rules installed by endpoint_monitor.py (AuditdMonitor).
##  Destination: /etc/audit/rules.d/endpoint_monitor.rules
##  Load with:   sudo augenrules --load   (or restart auditd)
##
##  Keys are consumed by endpoint_monitor.py to derive severity + tags.
##  See AUDIT_KEY_MAP in endpoint_monitor.py.
## ──────────────────────────────────────────────────────────────────────

## Drop existing rules so we start fresh (auditd will merge files in rules.d/)
## Comment out the next line if you want to layer on top of other rules.
# -D

## Buffer size (bump for busy systems; default is 8192)
-b 16384

## Failure mode: 1 = printk warning on overflow (safe for prod)
-f 1

## Ignore our own log writer to avoid noise/feedback
-a never,exit -F arch=b64 -F path=/var/log/endpoint_monitor -k self_exclude

## ── 1. Process Execution ─────────────────────────────────────────────
##  Tracks every execve syscall.
##  auid>=1000 filters out system services (kernel threads have auid=4294967295).
-a always,exit -F arch=b64 -S execve -F auid>=1000 -F auid!=-1 -k proc_exec
-a always,exit -F arch=b32 -S execve -F auid>=1000 -F auid!=-1 -k proc_exec

## ── 2. Network Connections (TCP/UDP, DNS) ────────────────────────────
-a always,exit -F arch=b64 -S connect -S accept -S accept4 -S bind -F auid>=1000 -F auid!=-1 -k net_conn
-a always,exit -F arch=b32 -S connect -S accept -S accept4 -S bind -F auid>=1000 -F auid!=-1 -k net_conn

## DNS config changes
-w /etc/resolv.conf -p wa -k dns_change
-w /etc/hosts       -p wa -k dns_change
-w /etc/nsswitch.conf -p wa -k dns_change

## ── 3. Privilege Escalation ──────────────────────────────────────────
-a always,exit -F arch=b64 -S setuid -S setgid -S setreuid -S setregid -S setresuid -S setresgid -k priv_esc
-a always,exit -F arch=b32 -S setuid -S setgid -S setreuid -S setregid -S setresuid -S setresgid -k priv_esc

-w /etc/sudoers     -p wa -k priv_esc
-w /etc/sudoers.d/  -p wa -k priv_esc
-w /usr/bin/sudo    -p x  -k priv_esc
-w /usr/bin/su      -p x  -k priv_esc
-w /usr/bin/pkexec  -p x  -k priv_esc
-w /usr/bin/newgrp  -p x  -k priv_esc

## Capabilities (file caps, capset)
-a always,exit -F arch=b64 -S capset -k priv_esc

## ── 4. Critical File Tampering ───────────────────────────────────────
-w /etc/passwd          -p wa -k file_tamper
-w /etc/shadow          -p wa -k file_tamper
-w /etc/group           -p wa -k file_tamper
-w /etc/gshadow         -p wa -k file_tamper
-w /etc/ssh/sshd_config -p wa -k file_tamper
-w /etc/ld.so.preload   -p wa -k file_tamper
-w /etc/ld.so.conf      -p wa -k file_tamper
-w /etc/ld.so.conf.d/   -p wa -k file_tamper
-w /etc/pam.d/          -p wa -k file_tamper

## Persistence — cron + systemd
-w /etc/crontab     -p wa -k file_tamper
-w /etc/cron.d/     -p wa -k file_tamper
-w /etc/cron.hourly/ -p wa -k file_tamper
-w /etc/cron.daily/  -p wa -k file_tamper
-w /var/spool/cron/ -p wa -k file_tamper
-w /etc/systemd/system/ -p wa -k file_tamper

## ── 5. Malware Staging (drops + executes in /tmp, /dev/shm) ──────────
##  Catches dropper writes (Mirai, coin miners, webshells)
-a always,exit -F arch=b64 -F dir=/tmp     -F perm=wa -F auid>=1000 -F auid!=-1 -k malware_staging
-a always,exit -F arch=b64 -F dir=/dev/shm -F perm=wa -F auid>=1000 -F auid!=-1 -k malware_staging
-a always,exit -F arch=b64 -F dir=/var/tmp -F perm=wa -F auid>=1000 -F auid!=-1 -k malware_staging

## ── 6. Shell / LOLBin Execution ──────────────────────────────────────
-w /bin/bash       -p x -k shell_exec
-w /bin/sh         -p x -k shell_exec
-w /bin/dash       -p x -k shell_exec
-w /usr/bin/zsh    -p x -k shell_exec
-w /usr/bin/nc     -p x -k shell_exec
-w /usr/bin/ncat   -p x -k shell_exec
-w /usr/bin/socat  -p x -k shell_exec
-w /usr/bin/curl   -p x -k shell_exec
-w /usr/bin/wget   -p x -k shell_exec
-w /usr/bin/python -p x -k shell_exec
-w /usr/bin/python3 -p x -k shell_exec
-w /usr/bin/perl   -p x -k shell_exec
-w /usr/bin/base64 -p x -k shell_exec

## ── 7. Kernel module loading (rootkits) ──────────────────────────────
-a always,exit -F arch=b64 -S init_module -S finit_module -S delete_module -k kmod_load
-w /etc/modprobe.conf -p wa -k kmod_load
-w /etc/modprobe.d/   -p wa -k kmod_load

## ── 8. Time changes (anti-forensics) ─────────────────────────────────
-a always,exit -F arch=b64 -S adjtimex -S settimeofday -S clock_settime -k time_change
-a always,exit -F arch=b32 -S adjtimex -S settimeofday -S clock_settime -k time_change

## ── 9. Identity / account management ─────────────────────────────────
-w /usr/sbin/useradd  -p x -k identity
-w /usr/sbin/userdel  -p x -k identity
-w /usr/sbin/usermod  -p x -k identity
-w /usr/sbin/groupadd -p x -k identity
-w /usr/sbin/passwd   -p x -k identity

## ── Make the config immutable until reboot (uncomment for production) ─
## When enabled, attackers cannot modify audit rules without rebooting.
# -e 2
